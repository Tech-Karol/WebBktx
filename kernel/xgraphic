/*
 * ============================================================
 * WebBktx XGraphics
 *
 * Version: 1.0
 *
 * Xbox-style graphics abstraction for WebBktx
 *
 * Features:
 *   - Canvas 2D backend
 *   - Software framebuffer
 *   - RGBA pixel format
 *   - SetResolution()
 *   - Clear()
 *   - Present()
 *   - requestAnimationFrame render loop
 *   - VSync-like frame scheduling
 *   - nearest / linear scaling
 *   - integer framebuffer coordinates
 *   - viewport support
 *   - drawPixel()
 *   - drawRect()
 *   - framebuffer access
 *   - frame statistics
 *   - resize handling
 *   - fullscreen helper
 *   - screenshot/export helpers
 *   - GPU backend preparation
 *
 * This is NOT a complete Xbox Direct3D implementation.
 *
 * ============================================================
 */

"use strict";


/* ============================================================
   VERSION
============================================================ */

const WEBBKTX_XGRAPHICS_VERSION = "1.0";


/* ============================================================
   DEFAULTS
============================================================ */

const XG_DEFAULT_WIDTH = 640;
const XG_DEFAULT_HEIGHT = 480;

const XG_DEFAULT_PIXEL_FORMAT = "RGBA8888";

const XG_DEFAULT_SCALE_MODE = "nearest";


/* ============================================================
   HELPERS
============================================================ */

function xgClamp(value, min, max) {

    return Math.max(
        min,
        Math.min(
            max,
            value
        )
    );

}


function xgU8(value) {

    return xgClamp(
        value | 0,
        0,
        255
    );

}


function xgColor(
    r = 0,
    g = 0,
    b = 0,
    a = 255
) {

    return {

        r: xgU8(r),
        g: xgU8(g),
        b: xgU8(b),
        a: xgU8(a)

    };

}


function xgColorToString(color) {

    return (
        "rgba(" +
        xgU8(color.r) +
        "," +
        xgU8(color.g) +
        "," +
        xgU8(color.b) +
        "," +
        (
            xgU8(color.a) / 255
        ) +
        ")"
    );

}


/* ============================================================
   FRAMEBUFFER
============================================================ */

class WebBktxFramebuffer {

    constructor(
        width,
        height
    ) {

        this.width = 0;
        this.height = 0;

        this.format =
            XG_DEFAULT_PIXEL_FORMAT;

        this.buffer = null;

        this.imageData = null;

        this.setSize(
            width,
            height
        );

    }


    /* ========================================================
       SIZE
    ======================================================== */

    setSize(
        width,
        height
    ) {

        width =
            Math.max(
                1,
                width | 0
            );

        height =
            Math.max(
                1,
                height | 0
            );


        this.width =
            width;

        this.height =
            height;


        this.buffer =
            new Uint8ClampedArray(
                width *
                height *
                4
            );


        this.imageData =
            null;

    }


    /* ========================================================
       INDEX
    ======================================================== */

    index(
        x,
        y
    ) {

        return (
            (
                y *
                this.width
            ) +
            x
        ) * 4;

    }


    /* ========================================================
       CLEAR
    ======================================================== */

    clear(
        r = 0,
        g = 0,
        b = 0,
        a = 255
    ) {

        r = xgU8(r);
        g = xgU8(g);
        b = xgU8(b);
        a = xgU8(a);


        const data =
            this.buffer;


        for (
            let i = 0;
            i < data.length;
            i += 4
        ) {

            data[i] =
                r;

            data[i + 1] =
                g;

            data[i + 2] =
                b;

            data[i + 3] =
                a;

        }

    }


    /* ========================================================
       SET PIXEL
    ======================================================== */

    setPixel(
        x,
        y,
        r,
        g,
        b,
        a = 255
    ) {

        x |= 0;
        y |= 0;


        if (
            x < 0 ||
            y < 0 ||
            x >= this.width ||
            y >= this.height
        ) {

            return false;

        }


        const i =
            this.index(
                x,
                y
            );


        this.buffer[i] =
            xgU8(r);

        this.buffer[i + 1] =
            xgU8(g);

        this.buffer[i + 2] =
            xgU8(b);

        this.buffer[i + 3] =
            xgU8(a);


        return true;

    }


    /* ========================================================
       GET PIXEL
    ======================================================== */

    getPixel(
        x,
        y
    ) {

        x |= 0;
        y |= 0;


        if (
            x < 0 ||
            y < 0 ||
            x >= this.width ||
            y >= this.height
        ) {

            return null;

        }


        const i =
            this.index(
                x,
                y
            );


        return {

            r:
                this.buffer[i],

            g:
                this.buffer[i + 1],

            b:
                this.buffer[i + 2],

            a:
                this.buffer[i + 3]

        };

    }


    /* ========================================================
       RECTANGLE
    ======================================================== */

    fillRect(
        x,
        y,
        width,
        height,
        r,
        g,
        b,
        a = 255
    ) {

        x |= 0;
        y |= 0;

        width |= 0;
        height |= 0;


        if (
            width <= 0 ||
            height <= 0
        ) {

            return;

        }


        const x1 =
            Math.max(
                0,
                x
            );

        const y1 =
            Math.max(
                0,
                y
            );

        const x2 =
            Math.min(
                this.width,
                x + width
            );

        const y2 =
            Math.min(
                this.height,
                y + height
            );


        if (
            x1 >= x2 ||
            y1 >= y2
        ) {

            return;

        }


        r = xgU8(r);
        g = xgU8(g);
        b = xgU8(b);
        a = xgU8(a);


        for (
            let py = y1;
            py < y2;
            py++
        ) {

            let index =
                this.index(
                    x1,
                    py
                );


            for (
                let px = x1;
                px < x2;
                px++
            ) {

                this.buffer[index] =
                    r;

                this.buffer[index + 1] =
                    g;

                this.buffer[index + 2] =
                    b;

                this.buffer[index + 3] =
                    a;


                index += 4;

            }

        }

    }


    /* ========================================================
       IMAGE DATA
    ======================================================== */

    getImageData() {

        if (
            typeof ImageData ===
            "undefined"
        ) {

            return null;

        }


        return new ImageData(
            this.buffer,
            this.width,
            this.height
        );

    }


    /* ========================================================
       RAW BUFFER
    ======================================================== */

    getBuffer() {

        return this.buffer;

    }


    /* ========================================================
       BYTE SIZE
    ======================================================== */

    get byteLength() {

        return this.buffer.length;

    }

}


/* ============================================================
   XGRAPHICS
============================================================ */

class WebBktxXGraphics {

    constructor(
        options = {}
    ) {

        this.version =
            WEBBKTX_XGRAPHICS_VERSION;


        /* ----------------------------------------------------
           CONFIGURATION
        ---------------------------------------------------- */

        this.width =
            options.width ||
            XG_DEFAULT_WIDTH;

        this.height =
            options.height ||
            XG_DEFAULT_HEIGHT;


        this.scale =
            options.scale ||
            1;


        this.scaleMode =
            options.scaleMode ||
            XG_DEFAULT_SCALE_MODE;


        this.autoCreateCanvas =
            options.autoCreateCanvas !== false;


        this.canvas =
            null;

        this.context =
            null;


        /* ----------------------------------------------------
           FRAMEBUFFER
        ---------------------------------------------------- */

        this.framebuffer =
            new WebBktxFramebuffer(
                this.width,
                this.height
            );


        /* ----------------------------------------------------
           STATE
        ---------------------------------------------------- */

        this.initialized =
            false;

        this.running =
            false;

        this.vsync =
            true;


        this.frameId =
            null;


        this.lastFrameTime =
            0;


        this.frameTime =
            0;


        this.deltaTime =
            0;


        this.frames =
            0;


        this.fps =
            0;


        this.fpsAccumulator =
            0;


        this.fpsFrames =
            0;


        /* ----------------------------------------------------
           VIEWPORT
        ---------------------------------------------------- */

        this.viewport = {

            x: 0,
            y: 0,

            width:
                this.width,

            height:
                this.height

        };


        /* ----------------------------------------------------
           GPU BACKEND PLACEHOLDER
        ---------------------------------------------------- */

        this.gpuBackend =
            null;


        this.backend =
            "canvas2d";


        /* ----------------------------------------------------
           CALLBACK
        ---------------------------------------------------- */

        this.onFrame =
            null;

        this.onPresent =
            null;

        this.onResize =
            null;


        /* ----------------------------------------------------
           AUTO INITIALIZATION
        ---------------------------------------------------- */

        if (
            options.autoInit !== false
        ) {

            this.initialize(
                options.canvas ||
                null
            );

        }

    }


    /* ========================================================
       INITIALIZE
    ======================================================== */

    initialize(
        canvas = null
    ) {

        if (
            this.initialized
        ) {

            return true;

        }


        if (
            typeof document ===
            "undefined"
        ) {

            throw new Error(
                "XGraphics requires a browser environment."
            );

        }


        /*
         * Use supplied canvas.
         */

        if (
            canvas
        ) {

            this.canvas =
                canvas;

        }


        /*
         * Search common canvas IDs.
         */

        if (
            !this.canvas
        ) {

            this.canvas =
                document.getElementById(
                    "webbktx-screen"
                );

        }


        if (
            !this.canvas
        ) {

            this.canvas =
                document.getElementById(
                    "screen"
                );

        }


        /*
         * Create canvas automatically.
         */

        if (
            !this.canvas &&
            this.autoCreateCanvas
        ) {

            this.canvas =
                document.createElement(
                    "canvas"
                );


            this.canvas.id =
                "webbktx-screen";


            if (
                document.body
            ) {

                document.body.appendChild(
                    this.canvas
                );

            }

        }


        if (
            !this.canvas
        ) {

            throw new Error(
                "XGraphics canvas not found."
            );

        }


        this.context =
            this.canvas.getContext(
                "2d",
                {

                    alpha: false,

                    desynchronized: true

                }
            );


        if (
            !this.context
        ) {

            throw new Error(
                "Canvas 2D context unavailable."
            );

        }


        this.configureCanvas();


        this.initialized =
            true;


        return true;

    }


    /* ========================================================
       CANVAS CONFIGURATION
    ======================================================== */

    configureCanvas() {

        this.canvas.width =
            this.width;

        this.canvas.height =
            this.height;


        this.canvas.style.imageRendering =
            this.scaleMode === "nearest"
                ? "pixelated"
                : "auto";


        this.context.imageSmoothingEnabled =
            this.scaleMode !== "nearest";


        this.context.clearRect(
            0,
            0,
            this.width,
            this.height
        );

    }


    /* ========================================================
       SET RESOLUTION
    ======================================================== */

    SetResolution(
        width,
        height
    ) {

        width =
            Math.max(
                1,
                width | 0
            );

        height =
            Math.max(
                1,
                height | 0
            );


        this.width =
            width;

        this.height =
            height;


        this.framebuffer.setSize(
            width,
            height
        );


        this.viewport = {

            x: 0,
            y: 0,

            width,
            height

        };


        if (
            this.canvas
        ) {

            this.configureCanvas();

        }


        if (
            typeof this.onResize ===
            "function"
        ) {

            this.onResize({

                width,
                height

            });

        }


        return {

            width,
            height

        };

    }


    /* ========================================================
       LOWERCASE ALIAS
    ======================================================== */

    setResolution(
        width,
        height
    ) {

        return this.SetResolution(
            width,
            height
        );

    }


    /* ========================================================
       VIEWPORT
    ======================================================== */

    SetViewport(
        x,
        y,
        width,
        height
    ) {

        this.viewport = {

            x: x | 0,
            y: y | 0,

            width:
                Math.max(
                    1,
                    width | 0
                ),

            height:
                Math.max(
                    1,
                    height | 0
                )

        };


        return {
            ...this.viewport
        };

    }


    /* ========================================================
       SCALE
    ======================================================== */

    SetScale(
        scale
    ) {

        scale =
            Number(scale);


        if (
            !Number.isFinite(scale) ||
            scale <= 0
        ) {

            scale = 1;

        }


        this.scale =
            scale;


        if (
            this.canvas
        ) {

            this.canvas.style.width =
                (
                    this.width *
                    scale
                ) + "px";


            this.canvas.style.height =
                (
                    this.height *
                    scale
                ) + "px";

        }


        return this.scale;

    }


    /* ========================================================
       SCALE MODE
    ======================================================== */

    SetScaleMode(
        mode
    ) {

        mode =
            String(mode)
                .toLowerCase();


        if (
            mode !== "nearest" &&
            mode !== "linear"
        ) {

            mode =
                "nearest";

        }


        this.scaleMode =
            mode;


        if (
            this.canvas
        ) {

            this.canvas.style.imageRendering =
                mode === "nearest"
                    ? "pixelated"
                    : "auto";

        }


        if (
            this.context
        ) {

            this.context.imageSmoothingEnabled =
                mode === "linear";

        }


        return mode;

    }


    /* ========================================================
       CLEAR
    ======================================================== */

    Clear(
        r = 0,
        g = 0,
        b = 0,
        a = 255
    ) {

        this.framebuffer.clear(
            r,
            g,
            b,
            a
        );


        return true;

    }


    /* ========================================================
       PIXEL
    ======================================================== */

    DrawPixel(
        x,
        y,
        r,
        g,
        b,
        a = 255
    ) {

        return this.framebuffer.setPixel(
            x,
            y,
            r,
            g,
            b,
            a
        );

    }


    /* ========================================================
       RECTANGLE
    ======================================================== */

    DrawRect(
        x,
        y,
        width,
        height,
        r,
        g,
        b,
        a = 255
    ) {

        this.framebuffer.fillRect(
            x,
            y,
            width,
            height,
            r,
            g,
            b,
            a
        );

    }


    /* ========================================================
       PRESENT
    ======================================================== */

    Present() {

        if (
            !this.initialized
        ) {

            this.initialize();

        }


        if (
            !this.context
        ) {

            return false;

        }


        const imageData =
            this.framebuffer.getImageData();


        if (
            !imageData
        ) {

            return false;

        }


        /*
         * Put the software framebuffer
         * onto the browser canvas.
         */

        this.context.putImageData(
            imageData,
            0,
            0
        );


        /*
         * GPU backend hook.
         *
         * A future GPU implementation can
         * intercept Present() here.
         */

        if (
            this.gpuBackend &&
            typeof this.gpuBackend.present ===
            "function"
        ) {

            this.gpuBackend.present(
                this.framebuffer,
                this
            );

        }


        if (
            typeof this.onPresent ===
            "function"
        ) {

            this.onPresent(
                this.getFrameStats()
            );

        }


        return true;

    }


    /* ========================================================
       FRAME
    ======================================================== */

    _frame(
        timestamp
    ) {

        if (
            !this.running
        ) {

            return;

        }


        if (
            !this.lastFrameTime
        ) {

            this.lastFrameTime =
                timestamp;

        }


        this.deltaTime =
            timestamp -
            this.lastFrameTime;


        this.lastFrameTime =
            timestamp;


        this.frames++;


        this.fpsAccumulator +=
            this.deltaTime;


        this.fpsFrames++;


        if (
            this.fpsAccumulator >=
            1000
        ) {

            this.fps =
                (
                    this.fpsFrames *
                    1000
                ) /
                this.fpsAccumulator;


            this.fpsAccumulator =
                0;

            this.fpsFrames =
                0;

        }


        /*
         * Emulator render callback.
         */

        if (
            typeof this.onFrame ===
            "function"
        ) {

            this.onFrame({

                time:
                    timestamp,

                delta:
                    this.deltaTime,

                graphics:
                    this

            });

        }


        /*
         * Present after emulator
         * rendering.
         */

        this.Present();


        if (
            this.running
        ) {

            this.frameId =
                requestAnimationFrame(
                    time =>
                        this._frame(
                            time
                        )
                );

        }

    }


    /* ========================================================
       START
    ======================================================== */

    Start() {

        if (
            this.running
        ) {

            return false;

        }


        if (
            !this.initialized
        ) {

            this.initialize();

        }


        this.running =
            true;


        this.lastFrameTime =
            0;


        this.frameId =
            requestAnimationFrame(
                time =>
                    this._frame(
                        time
                    )
            );


        return true;

    }


    /* ========================================================
       STOP
    ======================================================== */

    Stop() {

        if (
            !this.running
        ) {

            return false;

        }


        this.running =
            false;


        if (
            this.frameId !== null
        ) {

            cancelAnimationFrame(
                this.frameId
            );

        }


        this.frameId =
            null;


        return true;

    }


    /* ========================================================
       VSYNC
    ======================================================== */

    SetVSync(
        enabled
    ) {

        this.vsync =
            Boolean(enabled);


        /*
         * Browser requestAnimationFrame is
         * inherently synchronized with the
         * display refresh cycle.
         */

        return this.vsync;

    }


    /* ========================================================
       FRAMEBUFFER ACCESS
    ======================================================== */

    GetFramebuffer() {

        return this.framebuffer;

    }


    getFramebuffer() {

        return this.GetFramebuffer();

    }


    /* ========================================================
       RAW PIXEL BUFFER
    ======================================================== */

    GetPixels() {

        return this.framebuffer.getBuffer();

    }


    /* ========================================================
       FRAME STATS
    ======================================================== */

    getFrameStats() {

        return {

            frames:
                this.frames,

            fps:
                this.fps,

            deltaTime:
                this.deltaTime,

            width:
                this.width,

            height:
                this.height,

            backend:
                this.backend,

            running:
                this.running

        };

    }


    /* ========================================================
       GPU BACKEND
    ======================================================== */

    AttachGPUBackend(
        backend
    ) {

        if (
            !backend ||
            typeof backend !== "object"
        ) {

            throw new Error(
                "Invalid GPU backend."
            );

        }


        this.gpuBackend =
            backend;


        this.backend =
            backend.name ||
            "gpu";


        if (
            typeof backend.initialize ===
            "function"
        ) {

            backend.initialize(
                this
            );

        }


        return true;

    }


    DetachGPUBackend() {

        if (
            this.gpuBackend &&
            typeof this.gpuBackend.shutdown ===
            "function"
        ) {

            this.gpuBackend.shutdown();

        }


        this.gpuBackend =
            null;


        this.backend =
            "canvas2d";

    }


    /* ========================================================
       FULLSCREEN
    ======================================================== */

    async Fullscreen() {

        if (
            !this.canvas
        ) {

            return false;

        }


        if (
            typeof this.canvas.requestFullscreen ===
            "function"
        ) {

            await this.canvas.requestFullscreen();

            return true;

        }


        return false;

    }


    /* ========================================================
       SCREENSHOT
    ======================================================== */

    Screenshot(
        type = "image/png",
        quality = 1
    ) {

        if (
            !this.canvas
        ) {

            return null;

        }


        return this.canvas.toDataURL(
            type,
            quality
        );

    }


    /* ========================================================
       DOWNLOAD FRAMEBUFFER DATA
    ======================================================== */

    GetImageData() {

        return this.framebuffer.getImageData();

    }


    /* ========================================================
       STATUS
    ======================================================== */

    GetStatus() {

        return {

            version:
                this.version,

            initialized:
                this.initialized,

            running:
                this.running,

            backend:
                this.backend,

            resolution: {

                width:
                    this.width,

                height:
                    this.height

            },

            viewport: {

                ...this.viewport

            },

            scale:
                this.scale,

            scaleMode:
                this.scaleMode,

            vsync:
                this.vsync,

            framebufferBytes:
                this.framebuffer.byteLength,

            frames:
                this.frames,

            fps:
                this.fps

        };

    }


    /* ========================================================
       RESET
    ======================================================== */

    Reset() {

        this.Stop();


        this.framebuffer.clear(
            0,
            0,
            0,
            255
        );


        this.frames =
            0;

        this.fps =
            0;

        this.fpsAccumulator =
            0;

        this.fpsFrames =
            0;

        this.lastFrameTime =
            0;

        this.deltaTime =
            0;


        this.Present();

    }

}


/* ============================================================
   XBOX-STYLE ALIASES
============================================================ */

WebBktxXGraphics.prototype.CreateDevice =
    function() {

        if (
            !this.initialized
        ) {

            this.initialize();

        }

        return this;

    };


WebBktxXGraphics.prototype.ResetDevice =
    function() {

        this.Reset();

    };


WebBktxXGraphics.prototype.BeginScene =
    function() {

        return true;

    };


WebBktxXGraphics.prototype.EndScene =
    function() {

        return true;

    };


WebBktxXGraphics.prototype.PresentFrame =
    function() {

        return this.Present();

    };


/* ============================================================
   GLOBAL API
============================================================ */

window.WebBktxFramebuffer =
    WebBktxFramebuffer;


window.WebBktxXGraphics =
    WebBktxXGraphics;


/*
 * Compatibility aliases.
 */

window.XGraphics =
    WebBktxXGraphics;


window.WebBktxGraphics =
    WebBktxXGraphics;


/* ============================================================
   FACTORY
============================================================ */

window.createWebBktxXGraphics =
    function(options = {}) {

        return new WebBktxXGraphics(
            options
        );

    };


